<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>diablo_lite_ctrl</name>
  <version>0.1.0</version>
  <description>
    Host-side control nodes of the DIABLO-lite robot: keyboard teleoperation (port of
    diablo_teleop) and a geometry_msgs/Twist to motion_msgs/MotionCtrl bridge with the
    diablo_ctrl_node heartbeat.
  </description>
  <maintainer email="mjeong497@gmail.com">mjeong</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>motion_msgs</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
