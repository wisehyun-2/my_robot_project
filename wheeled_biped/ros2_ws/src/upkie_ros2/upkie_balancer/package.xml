<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>upkie_balancer</name>
  <version>0.1.0</version>
  <description>
    Balancer node of Plan 1: upkie wheel balancer (PI) or MPC balancer running on the spine
    observation, mapped to servo commands with the gyropod mapping.
  </description>
  <maintainer email="mjeong497@gmail.com">mjeong</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>wbr_msgs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <!-- the wbr core (controllers, qpmpc/qpsolvers for the MPC) is installed with pip: see ros2_ws/README.md -->

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
