  <link name="left_thigh"><inertial><origin xyz="0 0 -0.0700"/><mass value="0.25"/><inertia ixx="4.173e-04" ixy="0" ixz="0" iyy="4.173e-04" iyz="0" izz="1.800e-05"/></inertial><visual><origin xyz="0 0 -0.0700"/><geometry><cylinder radius="0.012" length="0.14"/></geometry><material name="grey"/></visual></link>
